DEFAULT_ANTHROPIC_API_KEY=
DEFAULT_GROK_API_KEY=
DEFAULT_OPENAI_API_KEY=
DEFAULT_GEMINI_API_KEY=
API_KEY_ENCRYPTION_SECRET=
DEFAULT_STABILITY_AI_API_KEY=

BACKEND_WEBHOOK_URL=
REDIS_URL=
WEBHOOK_SECRET=

#AWS
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CDN_URL=

CREDIT_PRECHECK_ENABLED=
CREDIT_SETTLE_DELAY_SECONDS=
MAX_RESERVATION_PER_REQUEST=

# Shared secret the Eddyter backend sends in X-Agent-Backend-Secret. When set, /agent/process requires it (401
# otherwise), and on /agent/email/* it lets the backend pass a provider key instead of a licence key. Empty: /agent/process
# stays open (startup warning) and the email routes require a licence. Set it on the backend first, then here.
AGENT_BACKEND_SECRET=

# Editable charts: Enhance suggestions and explicit chart requests on type general (docs/GRAPH_API_HANDOFF.md)
CHART_SUGGESTIONS_ENABLED=true

# Claude advanced tier (claude-opus-5-5) thinking depth: low | medium | high | xhigh | max. "low" measured as good as medium and faster/cheaper.
CLAUDE_ADVANCED_EFFORT=low

# Claude basic tier (claude-sonnet-5-5) thinking depth; empty = the model default. Measured: low made no difference on quick edits or long documents.
# CLAUDE_BASIC_EFFORT=

# OpenAI advanced tier (gpt-6.1-terra) reasoning effort: none | low | medium | high | xhigh. "none" measured fastest; tool-using agents always run at none.
OPENAI_ADVANCED_EFFORT=none

# Startup check of every configured model and platform key (free lookups; logs "ROLLOUT_ALERT preflight ..." on a problem).
MODEL_PREFLIGHT_ON_START=true
# Roll a model back without a deploy (restart the service). MODEL_<ADVANCED|BASIC|AUTOCOMPLETE|DESIGN>_<OPENAI|CLAUDE|GROK|DEEPSEEK|GEMINI>, e.g.
# MODEL_ADVANCED_OPENAI=gpt-5.2
# See docs/ROLLOUT_RUNBOOK.md for the rollback value of every 2026-11 change.

# Document actions (document_action "auto", exact-text Draft, in-line Edit additions). All optional: leave a variable unset for the default
# shown. A blank value is rejected at start-up, so uncomment a line only to change it. Table and meaning: docs/DOCUMENT_CONTEXT_API_HANDOFF.md.
# DOCUMENT_ACTION_CLASSIFIER_ENABLED=true
# DOCUMENT_ACTION_CLASSIFIER_TIMEOUT_SECONDS=4.0
# DOCUMENT_ACTION_CLASSIFIER_CONCURRENCY=16
# DOCUMENT_ACTION_DIGEST_CHARS=900
# DOCUMENT_LITERAL_MAX_REQUEST_CHARS=400
# DOCUMENT_EDIT_SMALL_INSERTION_CHARS=80
# DOCUMENT_EDIT_SMALL_ADDITION_MAX_WORDS=12

# Document upload (POST /agent/documents/upload). All optional, same rules as above. Table and meaning: docs/DOCUMENT_UPLOAD_API_HANDOFF.md.
# DOCUMENT_UPLOAD_MAX_CONCURRENT=2
# DOCUMENT_UPLOAD_SMALL_FILE_BYTES=16000
# DOCUMENT_UPLOAD_QUEUE_WAIT_SECONDS=10.0

# Long-document operations. Shorten (make_shorter) uses the advanced-tier model because the basic tier barely shortens a passage (2-9% measured).
# Credits are priced per character, so this raises the platform's cost per shorten request, not the user's. false = use each operation's single-call tier.
# LONGFORM_TIER_OVERRIDES=true

# Document import (POST /agent/documents/import): DOCX, PDF, HTML files and web addresses to Markdown. Each conversion runs in a child process with
# an empty environment and resource limits. All optional, same rules as above. Table and meaning: docs/DOCUMENT_IMPORT_API_HANDOFF.md.
# DOCUMENT_IMPORT_ENABLED=true
# DOCUMENT_IMPORT_URLS_ENABLED=true
# DOCUMENT_IMPORT_MAX_CONCURRENT=2
# DOCUMENT_IMPORT_FETCH_CONCURRENT=4
# DOCUMENT_IMPORT_MAX_FILE_BYTES=15000000
# DOCUMENT_IMPORT_TIMEOUT_SECONDS=30.0
# DOCUMENT_IMPORT_MAX_PDF_PAGES=200
# DOCUMENT_IMPORT_MEMORY_MB=1536

# Long-document Ask. All optional, same rules as above. Table and meaning: docs/DOCUMENT_CONTEXT_API_HANDOFF.md.
# DOCUMENT_RETRIEVAL_BUDGET_BYTES=10000
# DOCUMENT_LARGE_ASK=refuse
