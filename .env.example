DEFAULT_ANTHROPIC_API_KEY=
DEFAULT_GROK_API_KEY=
DEFAULT_OPENAI_API_KEY=
DEFAULT_GEMINI_API_KEY=
API_KEY_ENCRYPTION_SECRET=
DEFAULT_STABILITY_AI_API_KEY=

BACKEND_WEBHOOK_URL=
REDIS_URL=
WEBHOOK_SECRET=

#AWS
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CDN_URL=

CREDIT_PRECHECK_ENABLED=
CREDIT_SETTLE_DELAY_SECONDS=
MAX_RESERVATION_PER_REQUEST=

# Shared secret the Eddyter backend sends in X-Agent-Backend-Secret. When set, /agent/process requires it (401
# otherwise), and on /agent/email/* it lets the backend pass a provider key instead of a licence key. Empty: /agent/process
# stays open (startup warning) and the email routes require a licence. Set it on the backend first, then here.
AGENT_BACKEND_SECRET=

# Editable charts: Enhance suggestions and explicit chart requests on type general (docs/GRAPH_API_HANDOFF.md)
CHART_SUGGESTIONS_ENABLED=true
