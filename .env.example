DEFAULT_ANTHROPIC_API_KEY=
DEFAULT_GROK_API_KEY=
DEFAULT_OPENAI_API_KEY=
DEFAULT_GEMINI_API_KEY=
API_KEY_ENCRYPTION_SECRET=
DEFAULT_STABILITY_AI_API_KEY=

BACKEND_WEBHOOK_URL=
REDIS_URL=
WEBHOOK_SECRET=

#AWS
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CDN_URL=

CREDIT_PRECHECK_ENABLED=
CREDIT_SETTLE_DELAY_SECONDS=
MAX_RESERVATION_PER_REQUEST=

# Shared secret the Eddyter backend sends in X-Agent-Backend-Secret. When set, /agent/process requires it (401
# otherwise), and on /agent/email/* it lets the backend pass a provider key instead of a licence key. Empty: /agent/process
# stays open (startup warning) and the email routes require a licence. Set it on the backend first, then here.
AGENT_BACKEND_SECRET=

# Editable charts: Enhance suggestions and explicit chart requests on type general (docs/GRAPH_API_HANDOFF.md)
CHART_SUGGESTIONS_ENABLED=true

# Claude advanced tier (claude-opus-5-5) thinking depth: low | medium | high | xhigh | max. "low" measured as good as medium and faster/cheaper.
CLAUDE_ADVANCED_EFFORT=low

# Claude basic tier (claude-sonnet-5-5) thinking depth; empty = the model default. Measured: low made no difference on quick edits or long documents.
# CLAUDE_BASIC_EFFORT=

# OpenAI advanced tier (gpt-6.1-terra) reasoning effort: none | low | medium | high | xhigh. "none" measured fastest; tool-using agents always run at none.
OPENAI_ADVANCED_EFFORT=none

# Startup check of every configured model and platform key (free lookups; logs "ROLLOUT_ALERT preflight ..." on a problem).
MODEL_PREFLIGHT_ON_START=true
# Roll a model back without a deploy (restart the service). MODEL_<ADVANCED|BASIC|AUTOCOMPLETE|DESIGN>_<OPENAI|CLAUDE|GROK|DEEPSEEK|GEMINI>, e.g.
# MODEL_ADVANCED_OPENAI=gpt-5.2
# See docs/ROLLOUT_RUNBOOK.md for the rollback value of every 2026-11 change.
